#include <iostream>
#include <string>
using namespace std;

class Student
{
private:
    int rollNumber;
    string name;
    string course;
    int admissionYear;

public:

    // Function to input student data
    void inputDetails()
    {
        cout << "Enter Roll Number: ";
        cin >> rollNumber;
        cin.ignore();

        cout << "Enter Name: ";
        getline(cin, name);

        cout << "Enter Course: ";
        getline(cin, course);

        cout << "Enter Admission Year: ";
        cin >> admissionYear;

        cout << "---------------------\n";
    }

    // Function to display student data
    void displayDetails() const
    {
        cout << "Roll Number: " << rollNumber << endl;
        cout << "Name: " << name << endl;
        cout << "Course: " << course << endl;
        cout << "Admission Year: " << admissionYear << endl;
        cout << "---------------------\n";
    }

    // Function to get Roll Number
    int getRollNumber() const
    {
        return rollNumber;
    }
};

int main()
{
    const int MAX_STUDENTS = 100;

    // Array of Student objects
    Student database[MAX_STUDENTS];

    // Number of students
    int currentCount = 0;
    int choice;

    cout << "=== College Record Digitization System ===" << endl;

    do
    {
        // Display menu
        cout << "\n1. Add New Student Record" << endl;
        cout << "2. Display All Student Records" << endl;
        cout << "3. Search Student by Roll Number" << endl;
        cout << "4. Exit" << endl;

        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice)
        {
            // Add student
            case 1:
                if (currentCount < MAX_STUDENTS)
                {
                    cout << "\n--- Enter Details for Student "
                         << currentCount + 1 << " ---" << endl;

                    database[currentCount].inputDetails();

                    currentCount++;

                    cout << "Record saved successfully!" << endl;
                }
                else
                {
                    cout << "Database full! Cannot add more records." << endl;
                }
                break;

            // Display all students
            case 2:
                if (currentCount == 0)
                {
                    cout << "No student records available." << endl;
                }
                else
                {
                    cout << "\n--- Total Student Records ---" << endl;

                    for (int i = 0; i < currentCount; i++)
                    {
                        database[i].displayDetails();
                    }
                }
                break;

            // Search student
            case 3:
            {
                if (currentCount == 0)
                {
                    cout << "No student records available to search." << endl;
                    break;
                }

                int searchRoll;
                bool found = false;

                cout << "Enter Roll Number to search: ";
                cin >> searchRoll;

                for (int i = 0; i < currentCount; i++)
                {
                    if (database[i].getRollNumber() == searchRoll)
                    {
                        cout << "\n--- Record Found ---" << endl;

                        database[i].displayDetails();

                        found = true;
                        break;
                    }
                }

                if (!found)
                {
                    cout << "Student with Roll Number "
                         << searchRoll << " not found." << endl;
                }

                break;
            }

            // Exit
            case 4:
                cout << "Exiting system. Goodbye!" << endl;
                break;

            // Invalid choice
            default:
                cout << "Invalid choice! Please choose between 1 and 4."
                     << endl;
        }

    } while (choice != 4);

    return 0;
}
