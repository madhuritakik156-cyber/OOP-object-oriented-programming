using namespace std;

// Function Template
template
T myMax(T x, T y)
{
return (x > y) ? x : y;
}

int main()
{

// comparting product prices
cout << "Higher Marks: "
    << myMax<int>(75, 90) << endl;

// Comparing product prices
cout << "Higher price: "
    << myMax<double>(499.5, 699.75)
    << endl;

// Comparing sensor readings
cout << "Higher Sensor Reading: "
    << myMax<float>(25.5f, 30.8f)
<< endl;

return 0;
}

